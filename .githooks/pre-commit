#!/usr/bin/env bash
#
# Chặn commit khi analyzer còn phàn nàn.
#
# Vì sao có file này: tính tới 26/08/2026, `main` đã **năm lần** được đẩy lên
# trong trạng thái `flutter analyze --fatal-infos` đỏ, và riêng bốn lỗi
# `discarded_futures` ở bee_mascot/celebration/onboarding đã bị sửa rồi mất lại
# **ba lần**. Cả năm lần đều phát hiện được trong ~20 giây bằng đúng lệnh dưới
# đây, trong khi một vòng CI mất 4–5 phút và một vòng release còn tốn thêm một
# build number.
#
# `--fatal-infos` là chủ ý của dự án: ở đây **info cũng là đỏ**.
#
# Hook chạy `dart format` TRƯỚC rồi mới `analyze`, đúng thứ tự của CI
# (.github/workflows/ci.yml, job "Phân tích tĩnh & định dạng"). Thứ tự này quan
# trọng: ngày 29/08/2026 CI đỏ bảy lần liền vì một dòng `if (sel) setState(...);`
# ở rewards_screen.dart dài quá 80 cột — máy mình analyze sạch, nhưng `dart format`
# trên CI bẻ nó thành `if` hai dòng không ngoặc, và `curly_braces_in_flow_control_
# structures` bắt ngay. Analyze mà không format trước thì không nhìn thấy được lỗi
# đó, nên hook phải format trước.
#
# Cài (mỗi máy làm một lần):
#     git config core.hooksPath .githooks
#
# Bỏ qua khi thật sự cần (hiếm, và phải có lý do):
#     git commit --no-verify

set -euo pipefail

if ! command -v flutter >/dev/null 2>&1; then
  echo "pre-commit: không thấy lệnh 'flutter' trong PATH — bỏ qua bước kiểm."
  echo "            Nhớ tự chạy: flutter analyze --fatal-infos"
  exit 0
fi

echo "pre-commit: dart format lib test integration_test ..."
dart format lib test integration_test

if ! git diff --quiet -- lib test integration_test; then
  cat <<'MSG'

pre-commit: dart format vừa sửa lại một số file — commit bị chặn.

  CI cũng format y hệt rồi mới analyze, nên bản chưa format có thể xanh ở máy
  mình mà đỏ trên CI. Xem lại thay đổi, `git add` rồi commit lại:
      git add -u && git commit

MSG
  exit 1
fi

echo "pre-commit: flutter analyze --fatal-infos ..."
if ! flutter analyze --fatal-infos; then
  cat <<'MSG'

pre-commit: analyzer còn lỗi — commit bị chặn.

  Sửa xong rồi commit lại. Nếu thiếu file sinh tự động thì chạy trước:
      dart run build_runner build --delete-conflicting-outputs
      flutter gen-l10n

  Thật sự cần bỏ qua: git commit --no-verify

MSG
  exit 1
fi
