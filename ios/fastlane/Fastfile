default_platform(:ios)

# IPA được Flutter build sẵn trước khi gọi lane này — xem
# `.github/workflows/release.yml`. Fastlane ở đây chỉ lo việc upload.
platform :ios do
  desc "Đẩy IPA lên TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
      in_house: false,
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ENV["IPA_PATH"],
      skip_waiting_for_build_processing: true,
    )
  end

  # Lane này **upload một build mới** lên App Store Connect, không phải đề bạt
  # build đã có sẵn trên TestFlight — nó nhận `IPA_PATH` mà workflow vừa build.
  # Hệ quả phải biết: chạy `beta` rồi chạy `release` **cùng một build number** thì
  # Apple từ chối ở lần sau ("The bundle version must be higher"). Muốn đưa đúng
  # cái build đã test trên TestFlight lên App Store thì bấm tay trên App Store
  # Connect; muốn dùng lane này thì tăng `+build` trong pubspec.yaml trước.
  desc "Upload một build mới lên App Store Connect (không tự nộp duyệt)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
      in_house: false,
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: ENV["IPA_PATH"],
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      automatic_release: false,
    )
  end
end
